@model IEnumerable<MiTiendaVirtual.Models.Pedido>

@{
    ViewData["Title"] = "PEDIDOS";
}

<h1>Lista de Pedidos</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Fecha</th>
            <th>Monto Total</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.FechaHora?.ToString("dd/MM/yyyy")</td>
                <td>@item.Total</td>
                <td>@item.Estado</td>
            </tr>
        }
    </tbody>
</table>
