@model IEnumerable<MiTiendaVirtual.Models.Tarjeta>
@{
    ViewData["Title"] = "TARJETAS";
}

<h1>Lista de Tarjetas</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Marca</th>
            <th>Número</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Marca</td>
                <td>@item.Numero</td>
            </tr>
        }
    </tbody>
</table>